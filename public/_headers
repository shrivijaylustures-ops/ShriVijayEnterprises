# Cloudflare Pages response headers.
# Files in /_astro/ have a content hash in their name, so they can be cached for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# The website editor: never indexed, always the newest version, and only allowed to talk to GitHub.
/editor/*
  X-Robots-Tag: noindex
  Cache-Control: no-cache
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://raw.githubusercontent.com; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
