---
import CataloguePage from '../components/CataloguePage.astro';
import items from '../data/ceramic.json';
---

<CataloguePage
  line="ceramic"
  items={items}
  description="Imported on-glaze ceramic colours (760 to 830°C) and glass colours (500 to 560°C) for third-firing decoration. Browse shades by code and enquire on WhatsApp."
  firingFor={(i) => (i.range === 'glass' ? '500 to 560°C' : '760 to 830°C')}
/>
