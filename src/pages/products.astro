---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import { groups, lineById, lines, productsOf, type Line } from '../data/lines';
import { productImage } from '../lib/images';
import site from '../data/site.json';
import { breadcrumbs, faqSchema } from '../lib/schema';

// Count per category: products for grade-based lines (one per name), shades for the rest.
const count = (l: Line) => {
  const items = productsOf(l.id);
  const n = l.layout === 'grades' ? new Set(items.map((g) => g.name)).size : items.length;
  const unit = l.layout === 'grades' ? 'product' : 'shade';
  return n ? `${n} ${unit}${n === 1 ? '' : 's'}` : 'Being added';
};

// Short answers to the questions buyers ask most. Built from the data files, so temperatures stay current.
const r = lineById;
const gold = productsOf('gold') as { purity: string }[];
const fixed = [...new Set(gold.map((g) => g.purity))].filter((x) => /\d/.test(x));
const purities = fixed.length > 1 ? `${fixed.slice(0, -1).join(', ')} and ${fixed.at(-1)}` : fixed.join('');
const faq = [
  {
    q: 'What firing temperature do your colours need?',
    a: `${lines
      .flatMap((l) => {
        const typed = l.types.filter((t) => t.min && t.max);
        if (typed.length) return typed.map((t) => `${t.label.toLowerCase()} colours at ${t.min} to ${t.max}°C`);
        return l.firing ? [`${l.title.toLowerCase()} at ${l.firing}`] : [];
      })
      .join(', ')
      .replace(/^./, (c) => c.toUpperCase())
      .replace(/, ([^,]*)$/, ', and $1')}.`,
  },
  {
    q: 'What purities of liquid gold do you make?',
    a: `Liquid gold in ${purities} purity, and liquid platinum lustre. Other purities are made to order.`,
  },
  {
    q: 'Do you have colours for glass as well as ceramics?',
    a: 'Yes. Glass colours, lustres for glassware, and liquid gold and platinum for glass, alongside on-glaze and in-glaze colours for ceramics.',
  },
  {
    q: 'Do you make gold-based lustres?',
    a: 'Yes. Lustres come in standard and gold-based shades, and we also supply an oil-base medium for ceramic colours.',
  },
  {
    q: 'Can I get a fired sample before ordering?',
    a: 'Yes. Screens show colour only approximately, so ask us for a fired sample before a production order.',
  },
  {
    q: 'How do I order or ask for a price?',
    a: `Send the product code and quantity on WhatsApp or call ${site.phones[0].display}, or email ${site.emails[0]}.`,
  },
  {
    q: 'Where are you based?',
    a: `In ${site.address.line2}, ${site.address.region}, India. The business started in 1975 as Spectrum India and supplies ceramic and glass decorators across India.`,
  },
];
const pageSchema = [breadcrumbs([{ name: 'Home', path: '/' }, { name: 'Products', path: '/products' }]), faqSchema(faq)];
---

<Base
  schema={pageSchema}
  title="Products"
  description={`${lines.map((l) => l.title).join(', ').replace(/, ([^,]*)$/, ' and $1')}. Firing ranges from ${Math.min(...lines.flatMap((l) => l.min ?? []))} to ${Math.max(...lines.flatMap((l) => l.max ?? []))}°C.`}
>
  <section class="wrap intro">
    <h1 data-reveal>Products</h1>
    <p class="lede" data-reveal style="--i:1">
      Lustres and liquid gold made in our Agra works, alongside imported ceramic colours chosen for purity and firing consistency.
    </p>
  </section>

  {
    groups.map((g) => (
      <section class="wrap group" aria-labelledby={`g-${g.id}`}>
        <h2 class="group-h" id={`g-${g.id}`} data-reveal>{g.title}</h2>
        <div class="list">
          {g.lines.map((line, i) => {
            const img = productImage(line.image);
            return (
              <a href={line.href} class="range bezel" data-reveal style={`--i:${i % 2}`}>
                <div class="plate range-plate">
                  <div class="range-media">
                    {img ? <Image src={img} alt="" widths={[480, 800]} sizes="(max-width: 860px) 100vw, 50vw" /> : <div class="range-glaze" />}
                  </div>
                  <div class="range-body">
                    <div class="range-top">
                      <h3>{line.title}</h3>
                      <span class="range-count num">{count(line)}</span>
                    </div>
                    {line.firing && <p class="range-firing num">{line.firing}</p>}
                    <p class="range-summary">{line.summary}</p>
                    {line.points.length > 0 && (
                      <ul class="range-points">
                        {line.points.map((p) => (
                          <li>
                            <Icon name="ph:check" aria-hidden="true" /> {p}
                          </li>
                        ))}
                      </ul>
                    )}
                    <span class="link-arrow">
                      View {line.short.toLowerCase()} <Icon name="ph:arrow-right" aria-hidden="true" />
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
  <section class="wrap faq" aria-labelledby="faq-h">
    <h2 id="faq-h" data-reveal>Common questions</h2>
    <dl class="faq-list">
      {
        faq.map((f, i) => (
          <div class="faq-row" data-reveal style={`--i:${i % 3}`}>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  /* Questions and answers side by side: no accordions, everything readable at once. */
  .faq {
    padding-block: clamp(56px, 8vw, 104px) 24px;
  }

  .faq h2 {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .faq-list {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .faq-row {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 12px 48px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .faq-row dt {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .faq-row dd {
    margin: 0;
    color: var(--ink-2);
    max-width: 62ch;
  }

  @media (max-width: 760px) {
    .faq-row {
      grid-template-columns: 1fr;
    }
  }

  .intro {
    display: grid;
    gap: 20px;
    padding-block: clamp(40px, 6vw, 80px) clamp(32px, 4vw, 56px);
  }

  .group {
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .group-h {
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    margin-bottom: 20px;
  }

  .list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .range {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: transform 0.5s var(--ease);
  }

  .range:hover {
    transform: translateY(-4px);
  }

  .range-plate {
    display: grid;
    height: 100%;
    grid-template-rows: auto 1fr;
  }

  .range-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .range-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }

  .range:hover .range-media :global(img) {
    transform: scale(1.04);
  }

  .range-glaze {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(70% 90% at 15% 20%, rgb(255 255 255 / 0.25), transparent 60%),
      radial-gradient(80% 120% at 100% 100%, #2f6d8a, transparent 65%),
      radial-gradient(70% 100% at 0% 100%, #8a3b2a, transparent 70%),
      #3c4a3f;
  }

  .range-body {
    display: grid;
    align-content: start;
    gap: 16px;
    padding: clamp(22px, 3vw, 36px);
  }

  .range-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
  }

  .range-top h3 {
    min-width: 0;
    font-size: clamp(1.8rem, 2.6vw, 2.3rem);
  }

  .range-firing {
    margin-top: -8px;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--gold-ink);
  }

  .range-count {
    flex: none;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .range-summary {
    color: var(--ink-2);
  }

  .range-points {
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 0.96rem;
  }

  .range-points li {
    display: flex;
    gap: 10px;
    align-items: baseline;
  }

  .range-points :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--gold-ink);
    transform: translateY(2px);
  }

  .range .link-arrow {
    justify-self: start;
  }

  @media (max-width: 860px) {
    .list {
      grid-template-columns: 1fr;
    }
  }
</style>
