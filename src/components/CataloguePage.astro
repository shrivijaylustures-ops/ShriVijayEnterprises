---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Catalogue from './Catalogue.jsx';
import GoldGrid from './GoldGrid.astro';
import OtherRanges from './OtherRanges.astro';
import { lineById, type LineId } from '../data/lines';
import { goldProducts, shadesFor } from '../lib/shades';
import { waLink } from '../lib/links';

interface Props {
  line: LineId;
  description: string;
  noun?: string;
}

const { line: id, description, noun = 'shades' } = Astro.props;
const line = lineById[id];
const notes = line.notes;
const shades = await shadesFor(id);
const goldCount = id === 'gold' ? (await goldProducts()).length : 0;
---

<Base title={line.title} description={description}>
  <section class="wrap head">
    <a class="back" href="/products"><Icon name="ph:arrow-left" aria-hidden="true" /> All products</a>
    <div class="head-grid">
      <h1 data-reveal>{line.title}</h1>
      <div class="head-side" data-reveal style="--i:1">
        <p class="lede">{line.summary}</p>
        <p class="firing num"><Icon name="ph:thermometer-simple" aria-hidden="true" /> Firing range {line.firing}</p>
        {notes.length > 0 && <ul class="notes">{notes.map((n) => <li>{n}</li>)}</ul>}
      </div>
    </div>
  </section>

  <section class="wrap body">
    {
      shades.length > 0 ? (
        <>
          <p class="note">
            <Icon name="ph:info" aria-hidden="true" />
            Screens show colour approximately. For an exact match, ask us for a fired sample.
          </p>
          {id === 'gold' ? (
            <>
              <p class="count num">
                {goldCount} products, {shades.length} grades
              </p>
              <GoldGrid />
            </>
          ) : (
            <Catalogue client:load items={shades} filters={line.filters} noun={noun} />
          )}
        </>
      ) : (
        <div class="empty bezel" data-reveal>
          <div class="plate empty-plate">
            <h2>The range is being added</h2>
            <p class="lede">
              We are photographing and cataloguing this range now. Tell us the shade or code you need and we will confirm availability and send details.
            </p>
            <a class="btn" href={waLink(`Hello, I would like to enquire about ${line.title}.`)} target="_blank" rel="noopener">
              WhatsApp us <span class="btn-icon"><Icon name="ph:whatsapp-logo" aria-hidden="true" /></span>
            </a>
          </div>
        </div>
      )
    }
  </section>

  <section class="wrap more">
    <h2 class="more-h">Other ranges</h2>
    <OtherRanges exclude={id} />
  </section>
</Base>

<style>
  .head {
    padding-top: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(32px, 4vw, 48px);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    font-size: 0.92rem;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 28px;
  }

  .back:hover {
    color: var(--ink);
  }

  .back :global(svg) {
    width: 16px;
    height: 16px;
  }

  .head-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px 64px;
    align-items: end;
  }

  .head-side {
    display: grid;
    gap: 16px;
  }

  .firing {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 500;
    color: var(--gold-ink);
  }

  .firing :global(svg) {
    width: 20px;
    height: 20px;
  }

  .body {
    padding-bottom: clamp(56px, 8vw, 96px);
  }

  .note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    padding: 14px 18px;
    border-radius: var(--radius-inner);
    background: var(--gold-soft);
    color: var(--ink-2);
    font-size: 0.95rem;
  }

  .note :global(svg) {
    flex: none;
    width: 20px;
    height: 20px;
    color: var(--gold-ink);
  }

  .empty-plate {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding: clamp(32px, 6vw, 72px);
    background:
      radial-gradient(60% 120% at 100% 0%, var(--gold-soft), transparent 70%),
      var(--surface);
  }

  .more {
    padding-bottom: 24px;
  }

  .more-h {
    font-size: 1.9rem;
    margin-bottom: 16px;
  }

  .notes {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 6px;
    color: var(--ink-2);
    font-size: 0.98rem;
  }

  .count {
    margin-bottom: 16px;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (max-width: 820px) {
    .head-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
