---
// Liquid gold and platinum are sold by purity grade, so each product is one card listing its grades.
import { Icon } from 'astro-icon/components';
import { goldProducts } from '../lib/shades';

const products = await goldProducts();
const STOCK: Record<string, string> = { in: 'In stock', low: 'Low stock', out: 'On order' };
---

<ul class="gold">
  {
    products.map((p, i) => (
      <li id={p.id} class="g-card" data-reveal style={`--i:${i % 3}`}>
        <div class="g-media">{p.img && <img src={p.img} alt={p.name} width="720" height="720" loading="lazy" decoding="async" />}</div>
        <div class="g-body">
          <div class="g-top">
            <h3 translate="no">{p.name}</h3>
            <span class="g-kind">{p.range === 'platinum' ? 'Platinum' : 'Gold'}</span>
          </div>
          <p class="g-meta num">For glass and ceramic, 500 to 830°C</p>
          <p class="g-label">Pick a grade to enquire</p>
          <ul class="g-grades">
            {p.grades.map((g) => (
              <li>
                <a href={g.enquire} target="_blank" rel="noopener" aria-label={`Enquire about ${p.name}, ${g.purity}, on WhatsApp`}>
                  <Icon name="ph:whatsapp-logo" aria-hidden="true" />
                  <span translate="no" class="num">
                    {g.purity}
                  </span>
                </a>
                {g.stock !== 'in' && <span class="g-stock">{STOCK[g.stock]}</span>}
              </li>
            ))}
          </ul>
          {p.grades.every((g) => g.stock === 'in') && <p class="g-instock">{p.grades.length > 1 ? 'All grades in stock' : 'In stock'}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .gold {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 20px;
  }

  /* Tray and plate, like the shade cards. */
  .g-card {
    display: flex;
    flex-direction: column;
    padding: 6px;
    border-radius: var(--radius);
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }

  .g-card:target {
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 0 0 2px var(--gold);
  }

  .g-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-inner);
    background: var(--surface);
  }

  .g-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }

  .g-card:hover .g-media img {
    transform: scale(1.04);
  }

  .g-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 6px;
    padding: 16px 12px 10px;
  }

  .g-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }

  .g-top h3 {
    font-size: 1.6rem;
  }

  .g-kind {
    font-size: 0.85rem;
    color: var(--gold-ink);
    font-weight: 500;
  }

  .g-meta {
    font-size: 0.9rem;
    color: var(--muted);
  }

  .g-label {
    margin-top: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink-2);
  }

  .g-grades {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .g-grades a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .g-grades a:hover {
    background: var(--gold-soft);
    border-color: var(--gold);
  }

  .g-grades a:active {
    transform: scale(0.98);
  }

  .g-grades :global(svg) {
    width: 18px;
    height: 18px;
    color: var(--gold-ink);
  }

  .g-stock {
    display: block;
    margin-top: 2px;
    font-size: 0.8rem;
    color: var(--warn);
  }

  .g-instock {
    margin-top: auto;
    padding-top: 10px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ok);
  }
</style>
